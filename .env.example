# 站点正式域名（用于 RSS / Sitemap / OG），Vercel 上未设置时自动使用生产域名
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 【必填·生产】会话签名密钥，生成方式：openssl rand -base64 32
AUTH_SECRET=

# 【必填·生产】Postgres 连接串（Vercel → Storage → 创建 Neon 数据库后自动注入 DATABASE_URL）
# 本地不填则自动使用嵌入式数据库（.data/pglite）
DATABASE_URL=

# 选填：设置后注册需填写邀请码，防止陌生人注册
REGISTER_INVITE_CODE=

# giscus 评论（可选），在 https://giscus.app 获取
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
